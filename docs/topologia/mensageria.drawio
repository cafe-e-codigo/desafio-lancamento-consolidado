<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" version="24.7.17">
  <diagram name="Mensageria - poison/fluxo" id="verety-mensageria-01">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ===================== TITULO ===================== -->
        <mxCell id="title" value="Verety - Mensageria (at-least-once) | quorum + taxonomia de erro" style="text;html=1;align=center;fontSize=18;fontStyle=1;fontColor=#1A237E;" vertex="1" parent="1">
          <mxGeometry x="360" y="10" width="680" height="30" as="geometry" />
        </mxCell>

        <!-- ===================== FAIXAS (grupos) ===================== -->
        <mxCell id="lane-relay" value="Servico de Lancamentos (Outbox + Relay)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8EAF6;strokeColor=#3949AB;verticalAlign=top;fontStyle=1;fontSize=13;fontColor=#1A237E;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="300" height="760" as="geometry" />
        </mxCell>
        <mxCell id="lane-broker" value="RabbitMQ (Amazon MQ) - objetos duraveis" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#EF6C00;verticalAlign=top;fontStyle=1;fontSize=13;fontColor=#E65100;" vertex="1" parent="1">
          <mxGeometry x="360" y="60" width="620" height="760" as="geometry" />
        </mxCell>
        <mxCell id="lane-consumer" value="Servico de Consolidado (Consumidor)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;verticalAlign=top;fontStyle=1;fontSize=13;fontColor=#1B5E20;" vertex="1" parent="1">
          <mxGeometry x="1000" y="60" width="340" height="760" as="geometry" />
        </mxCell>

        <!-- ===================== RELAY ===================== -->
        <mxCell id="relay" value="Relay (poller)&#xa;SELECT ... FOR UPDATE SKIP LOCKED&#xa;publisher-confirm ASSYNC (por delivery_tag)&#xa;delivery_mode=2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C5CAE9;strokeColor=#3949AB;" vertex="1" parent="1">
          <mxGeometry x="90" y="300" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="outbox" value="outbox (Postgres)&#xa;status: PENDING / PUBLISHED / FAILED" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#D1C4E9;strokeColor=#512DA8;" vertex="1" parent="1">
          <mxGeometry x="90" y="120" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="e-outbox-relay" value="lote" style="endArrow=block;html=1;rounded=0;strokeColor=#512DA8;" edge="1" parent="1" source="outbox" target="relay">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===================== BROKER: EXCHANGE ===================== -->
        <mxCell id="exchange" value="caixa.lancamentos.exchange&#xa;[topic, durable]&#xa;rk: lancamento.criado.debito|credito" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#FFE0B2;strokeColor=#EF6C00;" vertex="1" parent="1">
          <mxGeometry x="420" y="300" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="e-relay-exch" value="publish&#xa;mandatory=true&#xa;basic.return se nao-roteada" style="endArrow=block;html=1;rounded=0;strokeColor=#EF6C00;fontSize=10;" edge="1" parent="1" source="relay" target="exchange">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===================== BROKER: MAIN QUEUE ===================== -->
        <mxCell id="mainq" value="consolidado-processamento-queue&#xa;[quorum]&#xa;delivery_mode=2 | prefetch=10&#xa;x-delivery-limit=dimensionado (nao cru=3)&#xa;dead-letter-strategy=at-least-once&#xa;overflow=reject-publish (+ x-max-length)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#FFE0B2;strokeColor=#EF6C00;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="420" y="470" width="240" height="140" as="geometry" />
        </mxCell>
        <mxCell id="e-exch-mainq" value="binding&#xa;rk casada" style="endArrow=block;html=1;rounded=0;strokeColor=#EF6C00;fontSize=10;" edge="1" parent="1" source="exchange" target="mainq">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===================== BROKER: DLX / DLQ ===================== -->
        <mxCell id="dlx" value="caixa.dlx&#xa;[direct, durable]" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#FFCDD2;strokeColor=#C62828;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="720" y="480" width="200" height="80" as="geometry" />
        </mxCell>
        <mxCell id="dlq" value="consolidado-processamento-dlq&#xa;[quorum, durable]&#xa;x-death: reason/count" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#FFCDD2;strokeColor=#C62828;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="720" y="620" width="200" height="100" as="geometry" />
        </mxCell>
        <mxCell id="e-dlx-dlq" value="dead-letter" style="endArrow=block;html=1;rounded=0;strokeColor=#C62828;fontSize=10;" edge="1" parent="1" source="dlx" target="dlq">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===================== BROKER: RETRY ===================== -->
        <mxCell id="retryq" value="consolidado-retry-queue&#xa;[TTL + DLX]&#xa;backoff progressivo&#xa;x-retry-count (header)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#FFF9C4;strokeColor=#F9A825;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="430" y="680" width="205" height="110" as="geometry" />
        </mxCell>
        <mxCell id="e-retry-mainq" value="TTL expira -> DLX devolve (backoff)" style="endArrow=block;html=1;rounded=1;dashed=1;strokeColor=#F9A825;fontSize=10;" edge="1" parent="1" source="retryq" target="mainq">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===================== CONSUMIDOR ===================== -->
        <mxCell id="consumer" value="Consumidor (ack manual)&#xa;1 SQL: processed_event ON CONFLICT (event_id, data) DO NOTHING&#xa;(marker + valor_signed na MESMA linha = ledger unico)&#xa;saldo_diario escrito SO pelo rollup (1 UPDATE / janela)&#xa;ack SO depois do COMMIT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#2E7D32;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1050" y="300" width="250" height="110" as="geometry" />
        </mxCell>
        <mxCell id="e-mainq-cons" value="basic.deliver&#xa;(prefetch=10)" style="endArrow=block;html=1;rounded=0;strokeColor=#2E7D32;fontSize=10;" edge="1" parent="1" source="mainq" target="consumer">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-cons-ack" value="ack (pos-COMMIT)" style="endArrow=block;html=1;rounded=1;dashed=1;strokeColor=#2E7D32;fontSize=10;" edge="1" parent="1" source="consumer" target="mainq">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===================== DECISAO: taxonomia ===================== -->
        <mxCell id="taxo" value="Taxonomia de erro&#xa;(no handler)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#0277BD;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1090" y="470" width="170" height="120" as="geometry" />
        </mxCell>
        <mxCell id="e-cons-taxo" value="rejeita/diferencia" style="endArrow=block;html=1;rounded=0;strokeColor=#0277BD;fontSize=10;" edge="1" parent="1" source="consumer" target="taxo">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- transiente -> retry -->
        <mxCell id="e-taxo-retry" value="TRANSIENTE&#xa;nack{requeue=false}" style="endArrow=block;html=1;rounded=0;strokeColor=#F9A825;fontSize=10;" edge="1" parent="1" source="taxo" target="retryq">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- veneno -> dlx -->
        <mxCell id="e-taxo-dlx" value="VENENO&#xa;reject{requeue=false}" style="endArrow=block;html=1;rounded=0;strokeColor=#C62828;fontSize=10;" edge="1" parent="1" source="taxo" target="dlx">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- mainq -> dlx (failsafe delivery-limit) -->
        <mxCell id="e-mainq-dlx" value="x-delivery-limit / reject-publish&#xa;(failsafe, nao e retry de negocio)" style="endArrow=block;html=1;rounded=1;dashed=1;strokeColor=#C62828;fontSize=10;" edge="1" parent="1" source="mainq" target="dlx">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- redrive DLQ -> mainq -->
        <mxCell id="e-dlq-mainq" value="REDRIVE IDEMPOTENTE&#xa;(shovel, preserva event_id)&#xa;-- ver runbook-dlq.md" style="endArrow=block;html=1;rounded=1;dashed=1;strokeColor=#6A1B9A;fontSize=10;" edge="1" parent="1" source="dlq" target="mainq">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===================== NOTA ===================== -->
        <mxCell id="nota" value="Garantia: at-least-once (broker). Efeito exatamente-uma-vez = dedup DURAVEL no consumidor (processed_event PK(event_id, data)). Confirm do publisher = durabilidade, NAO dedup. Redrive e seguro porque a dedup sobrevive ao replay. Prova local = semantica de execucao, nunca capacidade ou alta disponibilidade." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#FFFDE7;strokeColor=#F9A825;align=left;fontSize=10;size=14;" vertex="1" parent="1">
          <mxGeometry x="60" y="100" width="240" height="130" as="geometry" />
        </mxCell>
        <mxCell id="legenda" value="Legenda: seta cheia = AMQP normal | seta tracejada = ack / retry / failsafe / redrive" style="text;html=1;align=left;fontSize=10;fontColor=#616161;" vertex="1" parent="1">
          <mxGeometry x="420" y="80" width="500" height="20" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
