        <mxCell id="title" value="Verety: Sequência do Write Path · POST /api/v1/lancamentos (RNF#1: 201 no COMMIT; broker fora do caminho)"
                style="text;html=1;fontSize=16;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="0" width="1320" height="30" as="geometry" />
        </mxCell>

        <mxCell id="l1" value="Comerciante" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
