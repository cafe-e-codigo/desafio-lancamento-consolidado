<mxfile host="app.diagrams.net" modified="2026-10-08T00:00:00.000Z" version="24.0.0" type="device">
  <diagram id="seq-write-path" name="Sequência: Write Path (POST→outbox→relay→broker→consumidor→saldo)">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1450" pageHeight="950" math="0" shadow="0">
      <root>
        <mxCell id="0" />
